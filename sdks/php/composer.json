{
    "version": "0.1.0-private.2",
    "description": "Receive-only temporary inbox API for authorized email-flow testing. Public access is not open.",
    "keywords": [        "Once Email",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://once-email.com",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenAPI",
            "homepage": "https://once-email.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "OnceEmail\\Sdk\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "OnceEmail\\Sdk\\Test\\" : "test/" }
    }
}
