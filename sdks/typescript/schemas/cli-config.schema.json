{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://once-email.com/schemas/once-email-test-config-v1.json",
  "title": "Once Email authorized email-flow test configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "api", "authorization", "trigger", "match", "extract", "report", "cleanup"],
  "properties": {
    "version": { "const": 1 },
    "api": { "type": "object", "additionalProperties": false, "required": ["baseUrl", "apiKeyEnv"], "properties": { "baseUrl": { "type": "string", "format": "uri", "const": "https://api.once-email.com" }, "apiKeyEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" } } },
    "authorization": { "type": "object", "additionalProperties": false, "required": ["environment", "targetHosts", "evidenceRef"], "properties": { "environment": { "enum": ["local", "test", "staging"] }, "targetHosts": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 253 } }, "evidenceRef": { "type": "string", "minLength": 3, "maxLength": 120 } } },
    "trigger": { "type": "object", "additionalProperties": false, "required": ["command", "addressInput"], "properties": { "command": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "maxLength": 512 } }, "addressInput": { "const": "stdin-json" } } },
    "match": { "type": "object", "additionalProperties": false, "required": ["fromDomain", "subjectIncludes", "receivedAfterTrigger", "timeoutSeconds"], "properties": { "fromDomain": { "type": "string", "minLength": 1, "maxLength": 253 }, "subjectIncludes": { "type": "string", "minLength": 1, "maxLength": 160 }, "receivedAfterTrigger": { "const": true }, "timeoutSeconds": { "type": "integer", "minimum": 10, "maximum": 300 } } },
    "extract": { "type": "object", "additionalProperties": false, "required": ["type", "pattern"], "properties": { "type": { "const": "otp" }, "pattern": { "const": "contextual-6-digit" } } },
    "report": { "type": "object", "additionalProperties": false, "required": ["formats", "includeSensitiveValues"], "properties": { "formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["json", "junit"] } }, "includeSensitiveValues": { "const": false } } },
    "cleanup": { "type": "object", "additionalProperties": false, "required": ["required"], "properties": { "required": { "const": true } } }
  }
}
